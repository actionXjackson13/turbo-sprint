{
  "name": "soundboard-desktop",
  "productName": "SoundBoard",
  "version": "1.0.0",
  "description": "SoundBoard for the DJ booth: the app in its own window, plus a panel that floats over rekordbox.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.soundboard.dj",
    "productName": "SoundBoard",
    "files": ["main.js", "preload.js", "panel-preload.js", "offline.html", "icon.png"],
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SoundBoard"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "icon.png",
      "category": "public.app-category.music"
    }
  }
}
