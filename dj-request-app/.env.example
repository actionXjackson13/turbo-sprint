# Supabase connection.
# Leave these blank (or delete this file) to run the app in local demo mode,
# which needs no backend at all.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Force the in-memory demo backend even when the credentials above are set.
# Useful for demoing the app without touching real event data.
VITE_DEMO_MODE=false

# Optional. A deployed workers/song-search.js URL, e.g.
#   https://song-search.<your-subdomain>.workers.dev
# Routes catalogue lookups through your own domain so that guests running an
# ad blocker can still search — `itunes.apple.com` is on several blocklists.
# Unset, the app calls Apple directly and falls back to MusicBrainz.
VITE_SEARCH_PROXY_URL=
