# Supabase connection.
# Leave these blank (or delete this file) to run the app in local demo mode,
# which needs no backend at all.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Force the in-memory demo backend even when the credentials above are set.
# Useful for demoing the app without touching real event data.
VITE_DEMO_MODE=false
